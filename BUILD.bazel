# =============================================================================
# Parallel Library BUILD Configuration (standalone)
# =============================================================================
# Standalone parallel computing library. Include root is the repository root so that:
#   "include/common/parallel_export.h"     -> include/common/parallel_export.h
#   "include/tools/parallel_tools.h"       -> include/tools/parallel_tools.h
#   "include/common/parallel_tools_api.h"  -> include/common/...
# =============================================================================

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:pkg.bzl", "pkg_tar")
load("//bazel:parallel.bzl", "parallel_copts", "parallel_defines", "parallel_linkopts")

package(default_visibility = ["//visibility:public"])

# =============================================================================
# Source File Groups
# =============================================================================

filegroup(
    name = "parallel_hdrs",
    srcs = glob(
        [
            "include/*.h",
            "include/tools/*.h",
            "include/common/*.h",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "parallel_srcs",
    srcs = glob(
        [
            "src/tools/*.cpp",
            "src/common/*.cpp",
        ],
        allow_empty = True,
    ),
)

# =============================================================================
# Parallel implementation library
# =============================================================================

cc_library(
    name = "parallel_lib",
    # Parallel backend: TBB > OpenMP > std_thread (matches CMake PARALLEL_BACKEND + legacy
    # flags). A single flat selects.with_or() -- a select() cannot be nested as another
    # select()'s branch value, so this intentionally does not special-case the discouraged
    # "both parallel_backend_tbb and enable_openmp set at once" combination: Bazel now reports
    # that as an explicit "multiple matching conditions" analysis error instead.
    srcs = [
        ":parallel_srcs",
    ] + selects.with_or({
        (
            "//bazel:parallel_backend_tbb",
            "//bazel:parallel_enable_tbb",
        ): glob(["src/tbb/*.cpp"], allow_empty = True),
        (
            "//bazel:parallel_backend_openmp",
            "//bazel:enable_openmp",
        ): glob(["src/openmp/*.cpp"], allow_empty = True),
        "//conditions:default": glob(["src/std_thread/*.cpp"], allow_empty = True),
    }),
    hdrs = [
        ":parallel_hdrs",
    ] + selects.with_or({
        (
            "//bazel:parallel_backend_tbb",
            "//bazel:parallel_enable_tbb",
        ): glob(["include/tbb/*.h", "include/tbb/*.hxx"], allow_empty = True),
        (
            "//bazel:parallel_backend_openmp",
            "//bazel:enable_openmp",
        ): glob(["include/openmp/*.h", "include/openmp/*.hxx"], allow_empty = True),
        "//conditions:default": glob(["include/std_thread/*.h", "include/std_thread/*.hxx"], allow_empty = True),
    }),
    copts = parallel_copts(),
    defines = parallel_defines() + select({
        "//bazel:shared_libs": ["PARALLEL_SHARED_DEFINE"],
        "//conditions:default": ["PARALLEL_STATIC_DEFINE"],
    }),
    local_defines = select({
        "//bazel:shared_libs": ["PARALLEL_BUILDING_DLL"],
        "//conditions:default": [],
    }),
    # No includes attribute: the package is the workspace root, so Bazel's default
    # -iquote <workspace_root> already resolves "common/..." and "tools/..." headers.
    # (includes = ["."] is rejected at the workspace root by Bazel 8+.)
    linkopts = parallel_linkopts(),
    linkstatic = select({
        "//bazel:shared_libs": False,
        "//conditions:default": True,
    }),
    deps = selects.with_or({
        (
            "//bazel:parallel_backend_tbb",
            "//bazel:parallel_enable_tbb",
        ): [
            "@tbb//:tbb",
            "@tbb//:tbbmalloc",
        ],
        "//conditions:default": [],
    }) + selects.with_or({
        (
            "//bazel:parallel_backend_openmp",
            "//bazel:enable_openmp",
        ): ["@parallel_openmp//:openmp_check"],
        "//conditions:default": [],
    }),
    alwayslink = False,
    visibility = [
        "//visibility:public",
    ],
)

# =============================================================================
# Public Parallel target
# =============================================================================

cc_library(
    name = "Parallel",
    deps = [
        ":parallel_lib",
    ],
    visibility = ["//visibility:public"],
)

# =============================================================================
# Install / export (bazel-side analogue of CMake's `install(TARGETS ...)` /
# `install(DIRECTORY include/ DESTINATION include/Parallel/include ...)`).
# `bazel build //:parallel_pkg_tar` produces a relocatable tarball; `bazel run
# //:install -- --destdir=/some/prefix` stages the same tree directly on disk.
# =============================================================================

pkg_files(
    name = "parallel_installed_hdrs",
    srcs = glob(
        ["include/**/*.h", "include/**/*.hxx", "include/**/*.hpp"],
        allow_empty = True,
    ),
    prefix = "include/Parallel/include",
    strip_prefix = strip_prefix.from_pkg("include"),
)

pkg_files(
    name = "parallel_installed_libs",
    srcs = [":parallel_lib"],
    prefix = "lib",
)

pkg_tar(
    name = "parallel_pkg_tar",
    srcs = [
        ":parallel_installed_hdrs",
        ":parallel_installed_libs",
    ],
)

pkg_install(
    name = "install",
    srcs = [
        ":parallel_installed_hdrs",
        ":parallel_installed_libs",
    ],
)
