# =============================================================================
# Parallel Library Tests BUILD Configuration
# =============================================================================
# Test targets for the Parallel library using GoogleTest.
# Equivalent to Testing/Cxx/CMakeLists.txt
# =============================================================================

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")
load("//bazel:parallel.bzl", "parallel_copts", "parallel_defines", "parallel_linkopts")

package(default_visibility = ["//visibility:public"])

# =============================================================================
# Parallel Tests Target
# =============================================================================

cc_test(
    name = "ParallelCxxTests",
    size = "large",
    timeout = "long",
    srcs = glob(
        ["Test*.cpp"],
        exclude = ["TestTbb*.cpp", "TestTBB*.cpp", "TestOpenMP*.cpp", "TestOmp*.cpp"],
        allow_empty = True,
    ) + selects.with_or({
        (
            "//bazel:parallel_backend_tbb",
            "//bazel:parallel_enable_tbb",
        ): glob(["TestTbb*.cpp", "TestTBB*.cpp"], allow_empty = True),
        "//conditions:default": [],
    }) + selects.with_or({
        (
            "//bazel:parallel_backend_openmp",
            "//bazel:enable_openmp",
        ): glob(["TestOpenMP*.cpp", "TestOmp*.cpp"], allow_empty = True),
        "//conditions:default": [],
    }),
    copts = parallel_copts(),
    defines = parallel_defines() + [
        "PARALLEL_GOOGLE_TEST",
        "USE_GTEST",
        "_VARIADIC_MAX=10",
        "PARALLEL_HAS_GTEST=1",
    ],
    includes = ["."],
    linkopts = parallel_linkopts(),
    deps = [
        "//:Parallel",
        "//Testing:parallelTest_header",
        "@com_google_googletest//:gtest",
        "@com_google_googletest//:gtest_main",
    ],
)

# =============================================================================
# Benchmark Targets
# One cc_binary per Benchmark*.cpp file, named benchmark_<suffix_lowercased> —
# mirrors the per-file foreach in Testing/Cxx/CMakeLists.txt (bench_sources loop).
# Build with: bazel build //Testing/Cxx:benchmark_<suffix>
# =============================================================================

[
    cc_binary(
        name = "benchmark_" + _src[len("Benchmark"):-len(".cpp")].lower(),
        srcs = [_src],
        copts = parallel_copts(),
        defines = parallel_defines(),
        linkopts = parallel_linkopts(),
        deps = [
            "//:Parallel",
            "@com_google_benchmark//:benchmark",
            "@com_google_benchmark//:benchmark_main",
        ],
    )
    for _src in glob(["Benchmark*.cpp"], allow_empty = True)
]
